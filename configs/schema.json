{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "banglish-sanitizer/output/v1.0.0",
  "title": "SanitizerOutput",
  "description": "Output contract for the on-device sanitizer (proposal v2, section 2). Frozen at v1.0.0; any change requires a version bump and a git tag.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sanitized_prompt", "pii", "preserved_entities", "uncertainties", "routing"],
  "properties": {
    "sanitized_prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized, PII-masked prompt. This is the only field sent to the cloud model."
    },
    "pii": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/pii_item" },
      "description": "Local-only mapping from placeholders to original spans. Never leaves the device; used to restore values in the cloud answer and to score PII span F1."
    },
    "preserved_entities": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/preserved_entity" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/uncertainty" }
    },
    "routing": {
      "type": "string",
      "enum": ["PROCEED", "PROCEED_WITH_FLAGS", "ASK_USER", "ESCALATE"]
    }
  },
  "$defs": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calibrated score in [0, 1], written with at most two decimals."
    },
    "pii_type": {
      "type": "string",
      "enum": [
        "PHONE",
        "NID",
        "ID_NUMBER",
        "ACCOUNT_NUMBER",
        "CARD_NUMBER",
        "TXN_ID",
        "OTP",
        "EMAIL",
        "PERSON_NAME",
        "ADDRESS"
      ],
      "description": "ID_NUMBER is used when a span is clearly an identifier but its exact type is unresolved (PII_BOUNDARY)."
    },
    "pii_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "placeholder", "span"],
      "properties": {
        "type": { "$ref": "#/$defs/pii_type" },
        "placeholder": {
          "type": "string",
          "pattern": "^<[A-Z_]+_[1-9][0-9]*>$",
          "description": "Must be <TYPE_n>, e.g. <TXN_ID_1>; the prefix must equal the type (checked in validate.py)."
        },
        "span": {
          "type": "string",
          "minLength": 1,
          "description": "Original surface text of the PII in the input."
        },
        "score": {
          "$ref": "#/$defs/score",
          "description": "Optional s_pii used by conformal risk control (section 4.6)."
        }
      }
    },
    "preserved_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["AMOUNT", "SERVICE", "DATE", "TIME", "QUANTITY", "ORGANIZATION", "LOCATION", "PRODUCT", "OTHER"]
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "types", "candidates", "aleatoric", "epistemic"],
      "properties": {
        "span": { "type": "string", "minLength": 1 },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
      
          "items": {
            "type": "string",
            "enum": ["TRANSLITERATION", "NUMERIC_AMBIGUITY", "PII_BOUNDARY", "DIALECT_MEANING", "INTENT"]
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "aleatoric": { "$ref": "#/$defs/score" },
        "epistemic": { "$ref": "#/$defs/score" }
      }
    }
  }
}
